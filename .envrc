use flake

PROJECT_ROOT=$(git rev-parse --show-toplevel)
export PROJECT_ROOT

# Both hooks of .pre-commit-config.yaml: the checks at a commit, `make check` at a push.
if [ ! -f "$PROJECT_ROOT/.git/hooks/pre-commit" ] || [ ! -f "$PROJECT_ROOT/.git/hooks/pre-push" ]; then
    pre-commit install
fi

uv sync
source "$PROJECT_ROOT/.venv/bin/activate"
echo -e "\033[0;32mActivated virtual environment ($(python -V))\033[0m"
